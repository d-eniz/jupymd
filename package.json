{
	"name": "jupymd",
	"version": "2.0.2",
	"description": "Use Jupyter notebooks in Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/verify-release-bundle.mjs",
		"watch": "tsc -w -p .",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"prepare": "husky",
		"test": "npm run test:typecheck && npm run test:unit && npm run test:integration",
		"test:unit": "node test/run.mjs unit",
		"test:typecheck": "tsc --noEmit -p test/tsconfig.json",
		"test:integration": "node test/run.mjs integration"
	},
	"keywords": [
		"obsidian",
		"jupyter",
		"jupytext",
		"markdown",
		"sync"
	],
	"author": "Deniz Terzioglu",
	"license": "MIT",
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@sinonjs/fake-timers": "^15.4.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^18.0.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/sinonjs__fake-timers": "^15.0.1",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"esbuild": "^0.25.2",
		"esbuild-plugin-svgr": "^3.1.1",
		"husky": "^9.1.7",
		"mocha": "^10.8.2",
		"obsidian": "^1.13.1",
		"tslib": "2.4.0",
		"typescript": "~5.9"
	},
	"dependencies": {
		"@codemirror/highlight": "^0.19.8",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/theme-one-dark": "^6.1.2",
		"@types/prismjs": "^1.26.5",
		"@uiw/react-codemirror": "^4.23.12",
		"highlight.js": "^11.11.1",
		"prismjs": "^1.30.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-syntax-highlighter": "^16.1.1"
	}
}

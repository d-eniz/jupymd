{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "node",
      "mocha",
      "@wdio/globals/types",
      "@wdio/mocha-framework",
      "wdio-obsidian-service"
    ],
    "useDefineForClassFields": false
  },
  "include": [
    "./**/*.ts",
    "../wdio.conf.mts",
    "../src/types/*.d.ts"
  ]
}
